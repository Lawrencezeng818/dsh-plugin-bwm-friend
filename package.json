{
  "name": "dsh-plugin-bwm-friend",
  "version": "0.5.0",
  "description": "BWM Friend × DSH「数字人沉浸式工作台」插件——AI Agent Identity Layer 的 DSH 入口（Presence/Context/Persona 皮肤层）。UI 与业务分离：原生 DSH 业务流 100% 原生，BWM 只做皮肤/外壳。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./invariant": "./invariant.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "CHANGELOG.md",
    "README.md",
    "cordis.patch.yml",
    "docs",
    "invariant.js",
    "lib",
    "packages",
    "static-ui"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test:core": "cd packages/bwm-runtime-core && node --test test/*.test.js",
    "test:host": "node --test tests/host-endpoints.test.cjs",
    "test:e2e": "node tests/e2e-smoke.cjs",
    "test": "npm run test:core && npm run test:host && npm run test:e2e"
  },
  "dependencies": {
    "@laikaton/bwm-skin-mira": "^1.1.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://gitee.com/zeng-tian818/dsh-plugin-bwm-friend.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "bwm-friend",
    "digital-human",
    "presence",
    "persona",
    "agent-identity"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "author": {
    "name": "laikaton"
  }
}
