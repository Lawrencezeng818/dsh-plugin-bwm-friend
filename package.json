{
  "name": "dsh-plugin-bwm-friend",
  "version": "0.8.51",
  "description": "BWM Friend × DSH「数字人沉浸式工作台」插件——AI Agent Identity Layer 的 DSH 入口（Presence/Context/Persona 皮肤层）。UI 与业务分离：原生 DSH 业务流 100% 原生，BWM 只做皮肤/外壳。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./invariant": "./invariant.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./factgate": "./factgate.js"
  },
  "files": [
    "CHANGELOG.md",
    "README.md",
    "cordis.patch.yml",
    "docs/BWM-ARCHITECTURE-BOUNDARY.md",
    "docs/BWM-FRIEND-PRODUCT-SPEC-v1.0.md",
    "docs/BWM-PROTOCOL-v1.md",
    "docs/BWM-SDK-CONTRACT-v0.1.md",
    "docs/BWM-SETTINGS-SCHEMA-v1.md",
    "docs/screenshots",
    "invariant.js",
    "lib",
    "packages/bwm-protocol/schema",
    "screenshots.json",
    "static-ui"
  ],
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test:core": "cd packages/bwm-runtime-core && node --test test/*.test.js",
    "test:theme": "node tests/theme-alias-parity.mjs",
    "test:artifact": "node tests/build-artifact-parity.mjs",
    "test:inject": "node --test tests/injected-scripts.test.mjs",
    "test:shots": "node --test tests/screenshots-declaration.test.mjs",
    "test:host": "node --test tests/host-endpoints.test.cjs",
    "test:e2e": "node tests/e2e-smoke.cjs",
    "test:pack": "node scripts/classify-docs-release.mjs && node tests/release-pack-smoke.mjs",
    "test:fresh": "node tests/release-fresh-dsh.mjs",
    "audit:release": "node scripts/audit-release.mjs",
    "prepack": "node scripts/classify-docs-release.mjs && node scripts/audit-release.mjs",
    "prepublishOnly": "npm run audit:release",
    "test": "npm run test:core && npm run test:artifact && npm run test:theme && npm run test:inject && npm run test:shots && npm run test:host && npm run test:e2e"
  },
  "dependencies": {
    "@laikaton/bwm-skin-mira": "^1.1.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lawrencezeng818/dsh-plugin-bwm-friend.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "bwm-friend",
    "digital-human",
    "presence",
    "persona",
    "agent-identity"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "author": {
    "name": "莱卡顿科技 Laikaton Technology",
    "url": "https://laikaton-tech.com"
  },
  "homepage": "https://laikaton-tech.com",
  "bugs": {
    "url": "https://github.com/Lawrencezeng818/dsh-plugin-bwm-friend/issues"
  }
}
